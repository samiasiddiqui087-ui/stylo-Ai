rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'samiasiddiqui087@gmail.com'
      );
    }

    function isValidStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 500));
    }

    // Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'description', 'category', 'brand', 'pricePkr', 'stock', 'images', 'sizes', 'colors', 'isFeatured', 'isNewArrival', 'isBestSeller', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sku', 'name', 'description', 'category', 'brand', 'pricePkr', 'originalPricePkr', 'stock', 'images', 'sizes', 'colors', 'occasion', 'season', 'details', 'isFeatured', 'isNewArrival', 'isBestSeller', 'createdAt', 'updatedAt'])
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 2000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.brand is string && data.brand.size() >= 2 && data.brand.size() <= 80
        && data.pricePkr is number && data.pricePkr >= 0 && data.pricePkr <= 10000000
        && (!('originalPricePkr' in data) || (data.originalPricePkr is number && data.originalPricePkr >= 0))
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && isValidStringList(data.images, 8) && data.images.size() >= 1
        && isValidStringList(data.sizes, 10) && data.sizes.size() >= 1
        && isValidStringList(data.colors, 10) && data.colors.size() >= 1
        && (!('occasion' in data) || (data.occasion is string && data.occasion.size() <= 60))
        && (!('season' in data) || (data.season is string && data.season.size() <= 60))
        && (!('details' in data) || (data.details is string && data.details.size() <= 1500))
        && data.isFeatured is bool
        && data.isNewArrival is bool
        && data.isBestSeller is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'plan', 'aiRequestsUsed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'phone', 'city', 'address', 'preferredColors', 'preferredStyle', 'preferredSize', 'role', 'plan', 'aiRequestsUsed', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 120
        && data.email is string && data.email.size() <= 180
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('preferredColors' in data) || isValidStringList(data.preferredColors, 10))
        && (!('preferredStyle' in data) || (data.preferredStyle is string && data.preferredStyle.size() <= 80))
        && (!('preferredSize' in data) || (data.preferredSize is string && data.preferredSize.size() <= 20))
        && data.role in ['customer', 'admin']
        && data.plan in ['free', 'premium']
        && data.aiRequestsUsed is int && data.aiRequestsUsed >= 0 && data.aiRequestsUsed <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWardrobeItem(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'category', 'color', 'season', 'size', 'isFavorite', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'category', 'brand', 'color', 'season', 'size', 'collectionName', 'imageUrl', 'isFavorite', 'notes', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category in ['Tops', 'Bottoms', 'Dresses', 'Outerwear', 'Shoes', 'Bags', 'Accessories', 'Jewellery']
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 80))
        && data.color is string && data.color.size() >= 1 && data.color.size() <= 50
        && data.season is string && data.season.size() >= 1 && data.season.size() <= 40
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 20
        && (!('collectionName' in data) || (data.collectionName is string && data.collectionName.size() <= 80))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && data.isFavorite is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp;
    }

    function isValidSavedOutfit(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'occasion', 'stylingExplanation', 'productIds', 'totalEstimatedPkr', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'occasion', 'season', 'aesthetic', 'stylingExplanation', 'colorPalette', 'productIds', 'totalEstimatedPkr', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.occasion is string && data.occasion.size() <= 80
        && (!('season' in data) || (data.season is string && data.season.size() <= 60))
        && (!('aesthetic' in data) || (data.aesthetic is string && data.aesthetic.size() <= 80))
        && data.stylingExplanation is string && data.stylingExplanation.size() <= 1500
        && (!('colorPalette' in data) || isValidStringList(data.colorPalette, 8))
        && isValidStringList(data.productIds, 10)
        && data.totalEstimatedPkr is number && data.totalEstimatedPkr >= 0
        && data.createdAt is timestamp;
    }

    function isValidSchedule(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'title', 'occasion', 'productIds', 'reminderEnabled', 'createdAt'])
        && data.keys().hasOnly(['userId', 'date', 'title', 'occasion', 'accessoriesNote', 'weatherNote', 'productIds', 'reminderEnabled', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.occasion is string && data.occasion.size() <= 80
        && (!('accessoriesNote' in data) || (data.accessoriesNote is string && data.accessoriesNote.size() <= 300))
        && (!('weatherNote' in data) || (data.weatherNote is string && data.weatherNote.size() <= 200))
        && isValidStringList(data.productIds, 10)
        && data.reminderEnabled is bool
        && data.createdAt is timestamp;
    }

    function isValidWishlistItem(data, userId) {
      return data.keys().hasAll(['userId', 'productId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'productId', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidCartItem(data, userId) {
      return data.keys().hasAll(['userId', 'productId', 'name', 'pricePkr', 'image', 'size', 'color', 'quantity', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'productId', 'name', 'pricePkr', 'image', 'size', 'color', 'quantity', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.pricePkr is number && data.pricePkr >= 0
        && data.image is string && data.image.size() <= 500
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 20
        && data.color is string && data.color.size() >= 1 && data.color.size() <= 40
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 50
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'customerName', 'customerPhone', 'deliveryAddress', 'city', 'items', 'subtotalPkr', 'deliveryChargePkr', 'discountPkr', 'totalPkr', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orderId', 'userId', 'customerName', 'customerPhone', 'customerEmail', 'deliveryAddress', 'city', 'postalCode', 'notes', 'discountCode', 'items', 'subtotalPkr', 'deliveryChargePkr', 'discountPkr', 'totalPkr', 'status', 'whatsappMessage', 'createdAt', 'updatedAt'])
        && data.orderId is string && data.orderId.size() >= 6 && data.orderId.size() <= 20 && data.orderId.matches('^IMM-[A-Z0-9]+$')
        && (!('userId' in data) || data.userId == null || (isVerifiedUser() && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128))
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 30
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 180))
        && data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 350
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 20))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('discountCode' in data) || (data.discountCode is string && data.discountCode.size() <= 40))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 25
        && data.items[0] is map
        && data.subtotalPkr is number && data.subtotalPkr >= 0
        && data.deliveryChargePkr is number && data.deliveryChargePkr >= 0
        && data.discountPkr is number && data.discountPkr >= 0
        && data.totalPkr is number && data.totalPkr >= 0
        && data.status in ['Pending WhatsApp Confirmation', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled']
        && (!('whatsappMessage' in data) || (data.whatsappMessage is string && data.whatsappMessage.size() <= 4000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderId', 'phoneLast4', 'city', 'itemCount', 'itemSummary', 'totalPkr', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orderId', 'phoneLast4', 'city', 'itemCount', 'itemSummary', 'totalPkr', 'status', 'createdAt', 'updatedAt'])
        && data.orderId is string && data.orderId.size() >= 6 && data.orderId.size() <= 20
        && data.phoneLast4 is string && data.phoneLast4.size() == 4
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 100
        && data.itemSummary is string && data.itemSummary.size() <= 500
        && data.totalPkr is number && data.totalPkr >= 0
        && data.status in ['Pending WhatsApp Confirmation', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['heroTitle', 'heroSubtitle', 'chatbotWelcome', 'defaultDeliveryChargePkr', 'freeShippingThresholdPkr', 'freePlanAiLimit', 'premiumPlanPricePkr', 'premiumPlanAiLimit', 'updatedAt'])
        && data.keys().hasOnly(['heroTitle', 'heroSubtitle', 'chatbotWelcome', 'defaultDeliveryChargePkr', 'freeShippingThresholdPkr', 'freePlanAiLimit', 'premiumPlanPricePkr', 'premiumPlanAiLimit', 'activeDiscountCode', 'activeDiscountPercent', 'updatedAt'])
        && data.heroTitle is string && data.heroTitle.size() <= 140
        && data.heroSubtitle is string && data.heroSubtitle.size() <= 400
        && data.chatbotWelcome is string && data.chatbotWelcome.size() <= 400
        && data.defaultDeliveryChargePkr is number && data.defaultDeliveryChargePkr >= 0
        && data.freeShippingThresholdPkr is number && data.freeShippingThresholdPkr >= 0
        && data.freePlanAiLimit is int && data.freePlanAiLimit >= 1
        && data.premiumPlanPricePkr is number && data.premiumPlanPricePkr >= 0
        && data.premiumPlanAiLimit is int && data.premiumPlanAiLimit >= 1
        && (!('activeDiscountCode' in data) || (data.activeDiscountCode is string && data.activeDiscountCode.size() <= 40))
        && (!('activeDiscountPercent' in data) || (data.activeDiscountPercent is number && data.activeDiscountPercent >= 0 && data.activeDiscountPercent <= 90))
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 180
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.status in ['New', 'Replied', 'Resolved']
        && data.createdAt is timestamp;
    }

    function isValidChatSession(data, userId) {
      return data.keys().hasAll(['userId', 'mode', 'messages', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'mode', 'messages', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.mode in ['stylist', 'shopping']
        && data.messages is list && data.messages.size() <= 60
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidTryOnResult(data, userId) {
      return data.keys().hasAll(['userId', 'productId', 'productName', 'previewDataUrl', 'disclaimer', 'createdAt'])
        && data.keys().hasOnly(['userId', 'productId', 'productName', 'previewDataUrl', 'disclaimer', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 140
        && data.previewDataUrl is string && data.previewDataUrl.size() >= 10 && data.previewDataUrl.size() <= 850000
        && data.disclaimer is string && data.disclaimer.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidInspiration(data) {
      return data.keys().hasAll(['title', 'category', 'imageUrl', 'stylingNote', 'productIds', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'imageUrl', 'stylingNote', 'productIds', 'createdAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.imageUrl is string && data.imageUrl.size() >= 5 && data.imageUrl.size() <= 500
        && data.stylingNote is string && data.stylingNote.size() >= 5 && data.stylingNote.size() <= 600
        && isValidStringList(data.productIds, 10)
        && data.createdAt is timestamp;
    }

    // Connection validation probe
    match /test/connection {
      allow get: if true;
    }

    // Admin registry
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Catalog Products
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Curated Style Inspirations
    match /inspirations/{lookId} {
      allow get: if isValidId(lookId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(lookId) && isValidInspiration(incoming());
      allow delete: if isAdmin() && isValidId(lookId);
    }

    // Site Configuration
    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow create, update: if isAdmin() && isValidId(configId) && isValidSiteConfig(incoming()) && incoming().updatedAt == request.time;
    }

    // Orders (PII protected; non-PII mirror used for public Order ID tracking)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == orderId
        && incoming().status == 'Pending WhatsApp Confirmation'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orderTracking/$(orderId));
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'notes']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Non-PII Order Tracking (single-doc get only, zero list scraping)
    match /orderTracking/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId)
        && isValidOrderTracking(incoming())
        && incoming().orderId == orderId
        && incoming().status == 'Pending WhatsApp Confirmation'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(orderId));
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrderTracking(incoming())
        && incoming().orderId == existing().orderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Support Inquiries
    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'New'
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // User Profiles & Private Subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'customer'
        && incoming().plan == 'free'
        && incoming().aiRequestsUsed == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUserProfile(incoming(), userId) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && incoming().plan == existing().plan
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'phone', 'city', 'address', 'preferredColors', 'preferredStyle', 'preferredSize', 'aiRequestsUsed', 'updatedAt'])
        )
      );

      match /wardrobe/{itemId} {
        allow get: if isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(itemId) && isOwner(userId) && isValidWardrobeItem(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isValidId(itemId) && isOwner(userId) && isValidWardrobeItem(incoming(), userId) && incoming().createdAt == existing().createdAt && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'brand', 'color', 'season', 'size', 'collectionName', 'imageUrl', 'isFavorite', 'notes']);
        allow delete: if isValidId(itemId) && isOwner(userId);
      }

      match /savedOutfits/{outfitId} {
        allow get: if isValidId(outfitId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(outfitId) && isOwner(userId) && isValidSavedOutfit(incoming(), userId) && incoming().createdAt == request.time;
        allow delete: if isValidId(outfitId) && isOwner(userId);
      }

      match /schedules/{scheduleId} {
        allow get: if isValidId(scheduleId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(scheduleId) && isOwner(userId) && isValidSchedule(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isValidId(scheduleId) && isOwner(userId) && isValidSchedule(incoming(), userId) && incoming().createdAt == existing().createdAt && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'title', 'occasion', 'accessoriesNote', 'weatherNote', 'productIds', 'reminderEnabled']);
        allow delete: if isValidId(scheduleId) && isOwner(userId);
      }

      match /wishlist/{itemId} {
        allow get: if isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(itemId) && isOwner(userId) && isValidWishlistItem(incoming(), userId) && incoming().createdAt == request.time;
        allow delete: if isValidId(itemId) && isOwner(userId);
      }

      match /cart/{cartItemId} {
        allow get: if isValidId(cartItemId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isValidId(cartItemId) && isOwner(userId) && isValidCartItem(incoming(), userId) && incoming().updatedAt == request.time;
        allow delete: if isValidId(cartItemId) && isOwner(userId);
      }

      match /chatSessions/{sessionId} {
        allow get: if isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isValidId(sessionId) && isOwner(userId) && isValidChatSession(incoming(), userId) && incoming().updatedAt == request.time;
        allow delete: if isValidId(sessionId) && isOwner(userId);
      }

      match /tryOnHistory/{tryOnId} {
        allow get: if isValidId(tryOnId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(tryOnId) && isOwner(userId) && isValidTryOnResult(incoming(), userId) && incoming().createdAt == request.time;
        allow delete: if isValidId(tryOnId) && isOwner(userId);
      }
    }
  }
}
